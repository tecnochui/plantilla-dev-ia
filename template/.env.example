# ──────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# ──────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copiar este archivo a .env
#      cp .env.example .env
#   2. Rellenar los valores reales.
#   3. NUNCA commitear el archivo .env (está en .gitignore).
#
# Para generar valores seguros:
#   openssl rand -hex 32      (para secretos de 64 caracteres hex)
#   openssl rand -base64 32   (para secretos base64)
#   uuidgen                   (para identificadores únicos)
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# Aplicación
# ──────────────────────────────────────────────
APP_NAME=mi-app
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es

# ──────────────────────────────────────────────
# Base de datos
# ──────────────────────────────────────────────
# Formato URL completa (recomendado):
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# O variables separadas (alternativa):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mydb
# DB_USER=user
# DB_PASSWORD=changeme

# ──────────────────────────────────────────────
# Seguridad
# ──────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Generar con: openssl rand -hex 32
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32
SESSION_TIMEOUT=3600

# CORS: orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Hash de contraseñas (bcrypt rounds)
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────
# OpenRouter (para Zoo Code)
# ──────────────────────────────────────────────
# Obtener en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-changeme
OPENROUTER_MODEL_ARCHITECT=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_CODE=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_DEBUG=qwen/qwen3-coder-next

# ──────────────────────────────────────────────
# APIs externas (opcional, según el proyecto)
# ──────────────────────────────────────────────
# # DeepSeek (para consultas directas)
# DEEPSEEK_API_KEY=sk-changeme
#
# # Google AI / Gemini
# GOOGLE_AI_API_KEY=AIzaSy-changeme
#
# # Anthropic / Claude
# ANTHROPIC_API_KEY=sk-ant-api03-changeme
#
# # OpenAI
# OPENAI_API_KEY=sk-changeme

# ──────────────────────────────────────────────
# Servicios de terceros (opcional)
# ──────────────────────────────────────────────
# # Redis (caché, sesiones, colas)
# REDIS_URL=redis://localhost:6379/0
#
# # Email (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=changeme
# SMTP_PASSWORD=changeme
# SMTP_FROM=noreply@example.com
#
# # Almacenamiento S3-compatible
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=mi-bucket
# S3_ACCESS_KEY=changeme
# S3_SECRET_KEY=changeme
# S3_REGION=us-east-1

# ──────────────────────────────────────────────
# Observabilidad (opcional)
# ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=changeme-if-using-sentry

# ──────────────────────────────────────────────
# Testing
# ──────────────────────────────────────────────
# Estas variables solo se usan en tests
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/mydb_test
TEST_JWT_SECRET=test-secret-not-for-production
TEST_BCRYPT_ROUNDS=4

# ──────────────────────────────────────────────
# Feature flags (opcional)
# ──────────────────────────────────────────────
FEATURE_NEW_UI=false
FEATURE_BETA_API=false