# deploy.yml.example — Plantilla de despliegue automatizado
#
# ⚠️  ESTE ARCHIVO NO SE EJECUTA. Es una plantilla comentada.
#
# Cómo usarlo:
#   1. Elegir un destino de despliegue (ver sección "Destinos" abajo).
#   2. Copiar el bloque correspondiente a .github/workflows/deploy.yml
#   3. Descomentar el bloque.
#   4. Configurar los secrets en GitHub (Settings → Secrets → Actions).
#   5. Hacer commit y push. El workflow se activa en el próximo push a main.
#
# ──────────────────────────────────────────────
# DESTINOS POSIBLES
# ──────────────────────────────────────────────
#
# A) VPS propio (Hetzner, DigitalOcean, Contabo, etc.)
#    Costo: $5-15/mes
#    Secrets: SSH_HOST, SSH_USER, SSH_KEY
#
# B) PaaS (Vercel, Netlify, Railway, Render)
#    Costo: gratis o $5-20/mes
#    Secrets: depende de la plataforma
#
# C) Docker Hub + servidor propio
#    Costo: $0-5/mes
#    Secrets: DOCKER_USERNAME, DOCKER_TOKEN, SSH_HOST, SSH_USER, SSH_KEY
#
# D) GitHub Pages (solo sitios estáticos)
#    Costo: gratis
#    Secrets: ninguno
#
# E) Servidor casero (con Cloudflare Tunnel)
#    Costo: $0 + dominio
#    Secrets: CLOUDFLARE_TOKEN, SSH_HOST, SSH_USER, SSH_KEY

